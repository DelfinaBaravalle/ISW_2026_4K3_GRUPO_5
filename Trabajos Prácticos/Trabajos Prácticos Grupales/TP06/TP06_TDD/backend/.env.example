# Copiar este archivo como .env y completar. Sin MP_ACCESS_TOKEN se usa Mercado Pago simulado.

# Access Token de las credenciales de prueba de tu aplicación de Mercado Pago (nunca subirlo ni compartirlo).
MP_ACCESS_TOKEN=

# Dirección del front a la que vuelve el comprador al salir del checkout. Mercado Pago descarta las URLs http,
# por eso el front se levanta con `npm run dev:https`.
FRONTEND_URL=https://localhost:5173

# API key de Resend para enviar los mails de verdad. Sin ella los mails solo se simulan.
RESEND_API_KEY=

# Mail del usuario de demo (sesión simulada), en lugar del ficticio visitante@ejemplo.com.
# Sin dominio propio, Resend solo deja enviar a la casilla con la que se creó la cuenta: poner esa casilla.
EMAIL_USUARIO_DEMO=

# Opcional: remitente con un dominio verificado en Resend (por defecto, onboarding@resend.dev).
EMAIL_REMITENTE=
